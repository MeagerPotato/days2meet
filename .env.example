# Copy to .env.local and fill in. Nothing here may be prefixed NEXT_PUBLIC_:
# every value below is read only by server code, and that prefix is what would
# put it in the browser bundle.

# Your Supabase project's URL.
# Dashboard -> Project Settings -> Data API -> Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key. Dashboard -> Project Settings -> API Keys.
# Either the legacy service_role JWT or a newer secret key (sb_secret_...) works;
# both bypass row level security, which is how this app reads its own tables —
# they have RLS on and no policies at all. Read only by lib/supabase.ts and the
# routes under app/api/**. Never import it from a "use client" file.
SUPABASE_SERVICE_ROLE_KEY=

# Key used to sign participant session cookies and to fingerprint addresses for
# creation rate limiting. Any 32+ byte random string.
# Generate one with:  node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out; it is not used to encrypt anything at rest.
SESSION_SECRET=

# Production only, set in Vercel: 1 sends visitors on the launch address
# (days2meet.vercel.app) to days2meet.allenkh.com, except anyone already signed
# in to the event they are opening. See middleware.ts. Leave unset locally.
# LEGACY_HOST_REDIRECT=1
